{
  "name": "ai-cli",
  "version": "2.0.0",
  "description": "AI Command Line Client with Agent System - A Claude Code-like TUI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ai-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "plugins",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "package": "npm run package:linux && npm run package:macos && npm run package:win",
    "package:linux": "nexe dist/index.js --target linux-x64-20.18.0 --output releases/ai-cli-linux-x64",
    "package:macos": "nexe dist/index.js --target mac-x64-20.18.0 --output releases/ai-cli-macos-x64",
    "package:win": "nexe dist/index.js --target windows-x64-20.18.0 --output releases/ai-cli-windows-x64.exe",
    "package:all": "npm run build && npm run package"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "releases/"
  },
  "keywords": [
    "ai",
    "cli",
    "tui",
    "chat",
    "openai",
    "agent",
    "multi-agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "figures": "^6.1.0",
    "ink": "^6.8.0",
    "openai": "^6.45.0",
    "ora": "^9.4.1",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "nexe": "^5.0.0-beta.4",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
